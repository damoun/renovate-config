{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "pinDigests": true,
  "rangeStrategy": "pin",
  "extends": [
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "description": "Keep Terraform version ranges, so a reusable module doesn't lock every consumer to one release.",
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "required_version",
        "required_provider"
      ],
      "rangeStrategy": "update-lockfile"
    }
  ]
}
