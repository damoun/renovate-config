{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": false,
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "My own reusable workflows, tracked by digest on main.",
      "matchPackageNames": ["damoun/.github"],
      "matchUpdateTypes": ["digest"],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
