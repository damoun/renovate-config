{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "docker:enableMajor",
    "preview:dockerCompose",
    "preview:dockerVersions",
    "customManagers:dockerfileVersions"
  ],
  "packageRules": [
    {
      "description": "Remove v prefix in regex `_VERSION` updates",
      "extractVersion": "^?v?(?<version>\\d+\\.\\d+\\.\\d+.*)$",
      "matchManagers": [
        "custom.regex"
      ],
      "versioning": "regex:^v?(?<major>\\d+)(\\.(?<minor>\\d+)\\.(?<patch>\\d+.*))?$"
    },
    {
      "description": "Renovate only gets Docker release timestamps from Docker Hub, so minimumReleaseAge would hold gcr.io distroless digest updates forever.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "gcr.io/distroless/**"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "minimumReleaseAge": null
    }
  ]
}
